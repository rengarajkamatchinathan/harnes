{
  "name": "@genie/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run --cwd ../../packages/artifact-runtime build && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev --config src-tauri/tauri.bun.conf.json",
    "desktop:mock": "VITE_GENIE_ENGINE=mock tauri dev --config src-tauri/tauri.bun.conf.json",
    "ui:shots": "node scripts/ui-shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource/poppins": "5.2.7",
    "@genie/protocol": "workspace:*",
    "@genie/ui": "workspace:*",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
