{
  "name": "genie-workspace",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "start": "bun scripts/tauri.ts dev",
    "dev": "bun scripts/tauri.ts dev",
    "tauri": "bun scripts/tauri.ts",
    "build:app": "bun scripts/build-app.ts",
    "web": "bun scripts/prep.ts --frontend-only && bun run --cwd apps/desktop dev",
    "prep": "bun scripts/prep.ts",
    "build:runtime": "bun run --cwd packages/artifact-runtime build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  }
}
