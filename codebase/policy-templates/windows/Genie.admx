<?xml version="1.0" encoding="utf-8"?>
<!-- Genie managed policy (spec 08 §5.1). Writes HKLM\Software\Policies\Genie; see
     crates/genie-config/src/mdm.rs for how values map to policy keys and the "Managed
     policy templates" section of codebase/README.md. -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="genie" namespace="Synergech.Policies.Genie" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Genie1" displayName="$(string.SUPPORTED_Genie1)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="Genie" displayName="$(string.Genie)" />
    <category name="Genie_Org" displayName="$(string.Cat_Org)"><parentCategory ref="Genie" /></category>
    <category name="Genie_Delivery" displayName="$(string.Cat_Delivery)"><parentCategory ref="Genie" /></category>
    <category name="Genie_Providers" displayName="$(string.Cat_Providers)"><parentCategory ref="Genie" /></category>
    <category name="Genie_Permissions" displayName="$(string.Cat_Permissions)"><parentCategory ref="Genie" /></category>
    <category name="Genie_MCP" displayName="$(string.Cat_MCP)"><parentCategory ref="Genie" /></category>
    <category name="Genie_Skills" displayName="$(string.Cat_Skills)"><parentCategory ref="Genie" /></category>
