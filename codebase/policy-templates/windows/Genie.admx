    <category name="Genie_Telemetry" displayName="$(string.Cat_Telemetry)"><parentCategory ref="Genie" /></category>
    <category name="Genie_Updates" displayName="$(string.Cat_Updates)"><parentCategory ref="Genie" /></category>
